SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=48090
DB_URL=jdbc:mysql://127.0.0.1:3306/planning-platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true&requireSSL=true
DB_USERNAME=planning_app
DB_PASSWORD=replace-with-database-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=
SQL_INIT_MODE=never
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password
DEMO_DATA_ENABLED=false
UPLOAD_ROOT=D:/planning-platform/data/uploads
EXPORT_ROOT=D:/planning-platform/data/exports
EXPORT_CLEANUP_CRON=0 20 3 * * *
EXPORT_PROCESSING_TIMEOUT_MINUTES=30
EXPORT_RECOVERY_DELAY_MS=60000
EXPORT_RECOVERY_INITIAL_DELAY_MS=60000
AUDIT_RETAIN_DAYS=90
AUDIT_CLEANUP_CRON=0 40 3 * * *
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
